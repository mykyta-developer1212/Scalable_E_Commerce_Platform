{
  "version": 2,
  "services": {
    "api_gateway": {
      "root": "api-gateway/"
    },
    "user_service": {
      "root": "user-service/"
    },
    "product_service": {
      "root": "product-service/"
    },
    "order_service": {
      "root": "order-service/"
    }
  },
  "rewrites": [
    { "source": "/users/(.*)", "destination": "user_service" },
    { "source": "/users", "destination": "user_service" },
    { "source": "/products/(.*)", "destination": "product_service" },
    { "source": "/products", "destination": "product_service" },
    { "source": "/orders/(.*)", "destination": "order_service" },
    { "source": "/orders", "destination": "order_service" },
    { "source": "/(.*)", "destination": "api_gateway" }
  ]
}