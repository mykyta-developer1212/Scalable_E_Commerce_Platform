{
  "services": {
    "product_service": {
      "root": "product-service/"
    },
    "order_service": {
      "root": "order-service/"
    },
    "user_service": {
      "root": "user-service/"
    }
  },
  "rewrites": [
    { "source": "/products/(.*)", "destination": "product_service" },
    { "source": "/orders/(.*)", "destination": "order_service" },
    { "source": "/users/(.*)", "destination": "user_service" }
  ]
}